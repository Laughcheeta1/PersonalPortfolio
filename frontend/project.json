{
    "name": "frontend",
    "sourceRoot": "frontend/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/frontend",
                "command": "bun run build"
            },
            "outputs": ["{projectRoot}/dist"]
        },
        "dev": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/frontend",
                "command": "bun dev"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "apps/frontend",
                "command": "bun run lint"
            }
        }
    }
}