{
    "name": "lambdas",
    "root": "lambdas",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/.aws-sam"],
            "options": {
                "cwd": "lambdas",
                "command": "set -a; [ -f .env ] && . ./.env; set +a; sam build --cached"
            }
        },
        "dev": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "lambdas",
                "command": "set -a; [ -f .env ] && . ./.env; set +a; sam local start-api --container-env-vars GROQ_API_KEY=${GROQ_API_KEY}"
            }
        },
        "deploy": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "lambdas",
                "command": "sam deploy --no-confirm-changeset --no-fail-on-empty-changeset"
            }
        }
    }

}
