{
    "name": "lambdas",
    "root": "lambdas",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{projectRoot}/.aws-sam"],
            "options": {
                "cwd": "lambdas",
                "command": "sam build --cached"
            }
        },
        "dev": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "lambdas",
                "command": "sam local start-api"
            }
        },
        "deploy": {
            "dependsOn": ["build"],
            "executor": "nx:run-commands",
            "options": {
                "cwd": "lambdas",
                "command": "sam deploy --no-confirm-changeset --no-fail-on-empty-changeset"
            }
        }
    }

}